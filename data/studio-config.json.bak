{
  "screens": [
    {
      "id": "scr-overview",
      "name": "System & Storage Overview",
      "enabled": true,
      "durationSec": 15,
      "transition": "fade",
      "backgroundType": "image",
      "backgroundColor": "#0B0E14",
      "backgroundImage": "/src/assets/images/lcd_bg_anodized_carbon_1795344155261.jpg",
      "backgroundDim": 0.45,
      "widgets": [
        {
          "id": "w-ov-clock",
          "type": "clock",
          "x": 16,
          "y": 16,
          "w": 224,
          "h": 96,
          "title": "System Clock",
          "accentColor": "#F59E0B",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.78,
          "borderOpacity": 0.25,
          "fontScale": 1
        },
        {
          "id": "w-ov-cpu",
          "type": "entity_number",
          "x": 16,
          "y": 120,
          "w": 224,
          "h": 112,
          "title": "CPU Utilization",
          "accentColor": "#F59E0B",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.78,
          "borderOpacity": 0.25,
          "fontScale": 1,
          "entityId": "server.cpu_percent"
        },
        {
          "id": "w-ov-temp",
          "type": "entity_number",
          "x": 16,
          "y": 240,
          "w": 224,
          "h": 120,
          "title": "CPU Package Temp",
          "accentColor": "#38BDF8",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.78,
          "borderOpacity": 0.25,
          "fontScale": 1,
          "entityId": "server.cpu_temp"
        },
        {
          "id": "w-ov-chart",
          "type": "apex_area",
          "x": 248,
          "y": 16,
          "w": 416,
          "h": 184,
          "title": "CPU & Memory Load",
          "accentColor": "#F59E0B",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.82,
          "borderOpacity": 0.25,
          "fontScale": 1,
          "entityIds": [
            "server.cpu_percent",
            "server.ram_percent"
          ],
          "chartVariant": "area",
          "chartSmooth": true
        },
        {
          "id": "w-ov-array",
          "type": "array_status",
          "x": 248,
          "y": 208,
          "w": 416,
          "h": 152,
          "title": "Unraid Array Status",
          "accentColor": "#10B981",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.82,
          "borderOpacity": 0.25,
          "fontScale": 1
        },
        {
          "id": "w-ov-radial",
          "type": "apex_radial",
          "x": 672,
          "y": 16,
          "w": 272,
          "h": 184,
          "title": "Array Capacity",
          "accentColor": "#10B981",
          "textColor": "#F8FAFC",
          "bgColor": "#0D131D",
          "bgOpacity": 0.82,
          "borderOpacity": 0.25,
          "fontScale": 1,
          "entityId": "server.array_used_pct",
          "binding": "array_percent"
        },
        {
          "id": "w-ov-thermals",
