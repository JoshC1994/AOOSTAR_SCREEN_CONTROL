# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Serial Safety Gate: MUST be explicitly set to "true" before the app writes to /dev/ttyACM0.
# Keep "false" until dry-run packet validation passes on the Diagnostics tab.
AOOSTAR_ENABLE_SERIAL_WRITES="false"

# Optional path override for the compiled zehnm/aoostar-rs asterctl binary
# AOOSTAR_ASTERCTL_BIN="/usr/local/bin/asterctl"
