# Network Bind Host:
# Defaults to 127.0.0.1 when unset. The Dockerfile sets AOOSTAR_BIND=0.0.0.0 for bridge networking.
AOOSTAR_BIND="127.0.0.1"

# WebUI Login Credentials:
# First run seeds admin / admin (salted scrypt hash in data/credentials.json, mode 0600).
# Optionally override via env (sets usingDefaultPassword=false):
# AOOSTAR_ADMIN_USER="admin"
# AOOSTAR_ADMIN_PASSWORD=""

# Set "true" only if you intentionally allow default admin/admin login from non-LAN IPs (not recommended).
AOOSTAR_ALLOW_DEFAULT_PASSWORD_PUBLIC="false"

# Optional API Bearer Token for automation scripts (or generate/rotate inside Settings > Security):
# AOOSTAR_API_TOKEN=""

# Allowed Host headers (comma-separated) for Unraid reverse proxy / LAN hostname access
# AOOSTAR_ALLOWED_HOSTS="192.168.1.50:3000,tower.local:3000"

# Set "true" only when running behind an HTTPS reverse proxy forwarding X-Forwarded-Proto/Host
AOOSTAR_TRUST_PROXY="false"

# Serial Safety Gate:
# MUST be explicitly enabled before writing packets to /dev/ttyACM0.
# Set AOOSTAR_LOCK_SERIAL_WRITES=true to forbid unlocking serial writes from the Web UI.
AOOSTAR_ENABLE_SERIAL_WRITES="false"
AOOSTAR_LOCK_SERIAL_WRITES="false"

# SSRF Protection:
# Comma-separated hostnames or CIDRs allowed for Home Assistant / custom HTTP connections if needed.
# Loopback (127.0.0.0/8, ::1), link-local, and cloud metadata (169.254.0.0/16) are blocked by default.
# AOOSTAR_SSRF_ALLOWLIST=""
# AOOSTAR_BLOCK_PRIVATE_NETS="false"

# Optional path override for the compiled zehnm/aoostar-rs asterctl binary
# AOOSTAR_ASTERCTL_BIN="/usr/local/bin/asterctl"
